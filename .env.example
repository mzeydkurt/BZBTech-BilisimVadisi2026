# ── Uygulama ──────────────────────────────────────────────
APP_NAME="Katılım Kampanya Analiz Platformu"
APP_ENV=development                    # development | production
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# ── Veritabanı ────────────────────────────────────────────
# PostgreSQL'e geçiş için SADECE bu satır değişir:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./data/app.db

# ── Scraping ──────────────────────────────────────────────
SCRAPER_USER_AGENT="TeknofestKatilimBot/1.0 (+https://github.com/BZBTech/katilim-kampanya-analiz)"
SCRAPER_REQUEST_DELAY_SECONDS=1.5
SCRAPER_TIMEOUT_SECONDS=30
SCRAPER_MAX_RETRIES=3
SCRAPER_RESPECT_ROBOTS=true            # true bırak — etik ve şartname uyumu
RAW_HTML_DIR=./data/raw_html

# ── On-premise ────────────────────────────────────────────
# true iken sistem HİÇBİR dış HTTP çağrısı yapmaz (scraping dahil devre dışı)
AIRGAP_MODE=false

# Derlenmiş arayüz dizini. `make build-web` sonrası backend bu dizini "/"
# altından servis eder; böylece tek port (8000) yeterli olur.
FRONTEND_DIST_DIR=../frontend/dist

# ── Çıkarım motoru / LLM ──────────────────────────────────
# SPRINT 3A: mock  ·  SPRINT 3B: local
# ⚠️ AIRGAP_MODE bu sağlayıcıyı ENGELLEMEZ: model localhost'ta çalışır, kurum
# ağının dışına çıkan bir istek değildir — on-premise iddiasının ta kendisidir.
LLM_PROVIDER=mock
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen3:8b               # Apache-2.0 · ~5,2 GB · README ile AYNI olmak zorunda
LOCAL_LLM_CONTEXT=4096
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2

# Prompt sürümü: her çıkarım kaydına yazılır ve önbellek anahtarına girer.
# Değiştirildiğinde eski yanıtlar kendiliğinden geçersizleşir.
PROMPT_VERSION=v1

# Sahte sağlayıcının davranışı (yalnızca LLM_PROVIDER=mock iken):
#   null    → her alan null döner (varsayılan; "bilgi yok" davranışı)
#   fixture → tests/fixtures/mock_llm/ altından okur
#   invalid → geçersiz JSON döndürür (hata yolu testi)
#   timeout → zaman aşımı fırlatır (hata yolu testi)
#   halluc  → kaynakta OLMAYAN kanıt üretir (halüsinasyon guard testi)
MOCK_LLM_MODE=null

# Gömme modeli — ⚠️ YALNIZCA LLM_PROVIDER=local İKEN GEÇERLİ.
# `evren` sağlayıcısında vektörü üreten model EVREN_EMBEDDING_MODEL'dir; iki
# alanın hangisinin geçerli olduğunu `active_embedding_model()` belirler.
# ⚠️ Bu değer bir OLLAMA ETİKETİ olmak zorunda ("BAAI/bge-m3" Ollama'da yok).
# Yanlış etiket sessiz ölüme yol açar: kayıtlı vektörler 1024 boyut, yerel
# model 768 üretir ve `cosine()` uyuşmazlıkta 0.0 döndürdüğü için anlamsal
# kanal HATA VERMEDEN çalışmaz olur (bkz. `app/ai/providers/__init__.py`).
EMBEDDING_MODEL=nomic-embed-text

# ── EVREN (TEKNOFEST bulut sağlayıcısı) ───────────────────
# ⚠️ YALNIZCA LLM_PROVIDER=evren İKEN OKUNUR. On-prem kurulumda bu blok BOŞ
# kalır ve sistem yalnızca localhost'taki Ollama ile çalışır — dış ağa hiçbir
# istek gitmez. `AIRGAP_MODE=true` iken `evren` sağlayıcısı zaten AÇILMAZ.
EVREN_BASE_URL=
EVREN_API_KEY=
EVREN_MODEL=llm-fast
EVREN_EMBEDDING_MODEL=bge-m3-embed
EVREN_RERANK_MODEL=rerank

# ── Sohbet zaman aşımı ────────────────────────────────────
# ⚠️ TOPLU ÇIKARIMDAN AYRI (LLM_TIMEOUT_SECONDS). Aşılırsa yanıt şablona
# düşer, hata dönmez. Yerel model SOĞUK BAŞLANGIÇTA 25 sn'yi aşıyor; on-prem
# gösterimde 120 yapın ve bir ısıtma sorgusu atın (ısındıktan sonra ~9 sn).
CHAT_TIMEOUT_SECONDS=25

# ── Vektör deposu ─────────────────────────────────────────
# local  → `embeddings` tablosu (kaba kuvvet kosinüs; kapalı ağ yolu)
# qdrant → uzak koleksiyon; erişilemezse SESSİZCE yerele düşer ve bu durum
#          yanıttaki `semantic_note` alanında bildirilir.
# ⚠️ Kapalı ağ kurulumunda `local` seçilir; Qdrant satırları boş kalabilir.
VECTOR_BACKEND=local
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=katip_kartlari
